# Copy this file to .env and fill secrets locally or in the deployment platform.
ACF_PRO_LICENSE=
ACF_PRO_SITE_URL=http://localhost:8000

# Gravity Forms Composer downloads require an active Elite or legacy Developer licence.
GF_LICENSE_KEY=
GF_SITE_URL=http://localhost:8000

# Safe local defaults; use strong environment-specific values in production.
WP_ENVIRONMENT_TYPE=local
WORDPRESS_DB_NAME=wordpress_db
WORDPRESS_DB_USER=wordpress_user
WORDPRESS_DB_PASSWORD=wordpress_pass
WORDPRESS_DB_ROOT_PASSWORD=root_pass
WORDPRESS_PORT=8000
