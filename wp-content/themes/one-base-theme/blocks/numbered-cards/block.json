{
    "$schema": "https://schemas.wp.org/trunk/block.json",
    "apiVersion": 3,
    "name": "a2e/numbered-cards",
    "version": "1.0.0",
    "title": "Numbered Cards",
    "category": "a2e",
    "icon": "slides",
    "description": "A horizontally scrolling row of numbered cards with image, description and link. Add, duplicate and reorder cards in List View.",
    "keywords": ["slider", "services", "cards"],
    "textdomain": "one-base-theme",
    "attributes": {
        "label": { "type": "string", "default": "Numbered cards" },
        "align": { "type": "string", "default": "full" }
    },
    "supports": { "html": false, "anchor": true, "align": ["wide", "full"], "spacing": { "margin": true } },
    "editorScript": "file:./index.js",
    "editorStyle": "file:./editor.css",
    "style": "file:./style.css",
    "render": "file:./render.php"
}
