{
    "$schema": "https://schemas.wp.org/trunk/block.json",
    "apiVersion": 3,
    "name": "one-202x/query-filters",
    "version": "1.1.0",
    "title": "Query Filters",
    "description": "Filter the enclosing Query Loop by taxonomy or public custom field, or change its sort order.",
    "category": "theme",
    "icon": "filter",
    "textdomain": "one-base-theme",
    "ancestor": [
        "core/query"
    ],
    "usesContext": [
        "query",
        "queryId",
        "enhancedPagination"
    ],
    "attributes": {
        "allLabel": {
            "type": "string",
            "default": ""
        },
        "orientation": {
            "type": "string",
            "enum": [
                "horizontal",
                "vertical"
            ],
            "default": "horizontal"
        },
        "heading": {
            "type": "string",
            "default": "",
            "role": "content"
        },
        "previewPostType": {
            "type": "string",
            "default": ""
        },
        "previewQueryId": {
            "type": "number",
            "default": 0
        },
        "source": {
            "type": "string",
            "default": ""
        },
        "options": {
            "type": "array",
            "default": []
        }
    },
    "supports": {
        "anchor": true,
        "html": false,
        "spacing": {
            "margin": true
        },
        "interactivity": true
    },
    "viewScriptModule": "file:./view.js",
    "editorScript": "file:./index.js",
    "style": "file:./style.css",
    "render": "file:./render.php",
    "styles": [
        {
            "name": "default",
            "label": "Checkboxes",
            "isDefault": true
        },
        {
            "name": "a2e-category-tabs",
            "label": "A2E category links"
        },
        {
            "name": "a2e-filter-buttons",
            "label": "A2E filter buttons"
        }
    ]
}
