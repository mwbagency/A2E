{
    "$schema": "https://schemas.wp.org/trunk/theme.json",
    "version": 3,
    "settings": {
        "appearanceTools": true,
        "useRootPaddingAwareAlignments": true,
        "layout": {
            "contentSize": "760px",
            "wideSize": "1200px"
        },
        "viewport": {
            "mobile": "37.5rem",
            "tablet": "64rem"
        },
        "color": {
            "custom": false,
            "defaultPalette": false,
            "palette": [
                {
                    "name": "Base",
                    "slug": "base",
                    "color": "#ffffff"
                },
                {
                    "name": "Contrast",
                    "slug": "contrast",
                    "color": "#191a23"
                },
                {
                    "name": "Accent",
                    "slug": "accent",
                    "color": "#b9ff66"
                },
                {
                    "name": "Surface",
                    "slug": "surface",
                    "color": "#f3f3f3"
                },
                {
                    "name": "Muted",
                    "slug": "muted",
                    "color": "#6b6c73"
                }
            ]
        },
        "spacing": {
            "blockGap": true,
            "margin": true,
            "padding": true,
            "defaultSpacingSizes": false,
            "units": [
                "px",
                "em",
                "rem",
                "vh",
                "vw",
                "%"
            ],
            "spacingSizes": [
                {
                    "name": "Small",
                    "slug": "sm",
                    "size": "1rem"
                },
                {
                    "name": "Medium",
                    "slug": "md",
                    "size": "1.5rem"
                },
                {
                    "name": "Large",
                    "slug": "lg",
                    "size": "2.5rem"
                },
                {
                    "name": "XL",
                    "slug": "xl",
                    "size": "4rem"
                },
                {
                    "name": "2XL",
                    "slug": "2-xl",
                    "size": "6rem"
                }
            ]
        },
        "typography": {
            "customFontSize": true,
            "defaultFontSizes": false,
            "fluid": true,
            "fontFamilies": [
                {
                    "name": "Primary sans",
                    "slug": "sans",
                    "fontFamily": "\"Space Grotesk\", Inter, system-ui, sans-serif",
                    "fontFace": [
                        {
                            "fontFamily": "Space Grotesk",
                            "fontStyle": "normal",
                            "fontWeight": "400 700",
                            "fontDisplay": "swap",
                            "fontStretch": "normal",
                            "src": [
                                "file:./assets/fonts/space-grotesk/space-grotesk-variable.woff2"
                            ]
                        }
                    ]
                }
            ],
            "fontSizes": [
                {
                    "name": "Body",
                    "slug": "body",
                    "size": "clamp(1rem, 0.96rem + 0.18vw, 1.125rem)"
                },
                {
                    "name": "Heading 6",
                    "slug": "h-6",
                    "size": "1rem"
                },
                {
                    "name": "Heading 5",
                    "slug": "h-5",
                    "size": "1.125rem"
                },
                {
                    "name": "Heading 4",
                    "slug": "h-4",
                    "size": "clamp(1.25rem, 1.14rem + 0.45vw, 1.55rem)"
                },
                {
                    "name": "Heading 3",
                    "slug": "h-3",
                    "size": "clamp(1.5rem, 1.31rem + 0.74vw, 2rem)"
                },
                {
                    "name": "Heading 2",
                    "slug": "h-2",
                    "size": "clamp(2rem, 1.7rem + 1.15vw, 2.75rem)"
                },
                {
                    "name": "Heading 1",
                    "slug": "h-1",
                    "size": "clamp(2.75rem, 2.15rem + 2.4vw, 4.5rem)"
                },
                {
                    "name": "Hero",
                    "slug": "hero",
                    "size": "clamp(3rem, 2.25rem + 3vw, 5.25rem)"
                }
            ]
        },
        "custom": {
            "typography": {
                "fontWeight": {
                    "regular": "400",
                    "medium": "500",
                    "semibold": "600",
                    "bold": "700"
                },
                "lineHeight": {
                    "tight": "1.06",
                    "regular": "1.15",
                    "loose": "1.45"
                },
                "letterSpacing": {
                    "tight": "-0.04em",
                    "regular": "0",
                    "loose": "0.04em"
                }
            },
            "radius": {
                "card": "2.5rem",
                "control": "0.875rem",
                "panel": "3rem"
            },
            "shadow": {
                "card": "0 0.375rem 0 #191a23"
            }
        }
    },
    "customTemplates": [
        {
            "name": "page-with-title",
            "title": "Page — automatic title",
            "postTypes": ["page"]
        }
    ],
    "templateParts": [
        {
            "area": "header",
            "name": "head",
            "title": "Head"
        },
        {
            "area": "footer",
            "name": "footer",
            "title": "Footer"
        },
        {
            "area": "navigation-overlay",
            "name": "head-navigation-overlay",
            "title": "Head Navigation Overlay"
        }
    ],
    "styles": {
        "color": {
            "background": "var:preset|color|base",
            "text": "var:preset|color|contrast"
        },
        "spacing": {
            "padding": {
                "left": "clamp(20px, 4vw, 80px)",
                "right": "clamp(20px, 4vw, 80px)"
            }
        },
        "typography": {
            "fontFamily": "var:preset|font-family|sans",
            "fontSize": "var:preset|font-size|body",
            "fontWeight": "400",
            "lineHeight": "1.45"
        },
        "elements": {
            "h1": {
                "typography": {
                    "fontSize": "var:preset|font-size|h-1",
                    "fontWeight": "500",
                    "lineHeight": "1.06",
                    "letterSpacing": "-0.04em"
                }
            },
            "h2": {
                "typography": {
                    "fontSize": "var:preset|font-size|h-2",
                    "fontWeight": "500",
                    "lineHeight": "1.1",
                    "letterSpacing": "-0.035em"
                }
            },
            "h3": {
                "typography": {
                    "fontSize": "var:preset|font-size|h-3",
                    "fontWeight": "500",
                    "lineHeight": "1.15"
                }
            },
            "h4": {
                "typography": {
                    "fontSize": "var:preset|font-size|h-4",
                    "fontWeight": "500"
                }
            },
            "h5": {
                "typography": {
                    "fontSize": "var:preset|font-size|h-5",
                    "fontWeight": "600"
                }
            },
            "h6": {
                "typography": {
                    "fontSize": "var:preset|font-size|h-6",
                    "fontWeight": "700",
                    "letterSpacing": "0.04em",
                    "textTransform": "uppercase"
                }
            }
        },
        "blocks": {
            "core/button": {
                "border": {
                    "radius": "0.875rem"
                },
                "color": {
                    "background": "var:preset|color|contrast",
                    "text": "var:preset|color|base"
                },
                ":hover": {
                    "color": {
                        "background": "var:preset|color|accent",
                        "text": "var:preset|color|contrast"
                    }
                },
                ":focus-visible": {
                    "outline": {
                        "color": "var:preset|color|contrast",
                        "offset": "0.25rem",
                        "style": "solid",
                        "width": "0.125rem"
                    }
                }
            },
            "core/navigation-link": {
                ":hover": {
                    "color": {
                        "text": "var:preset|color|muted"
                    }
                },
                "-current": {
                    "typography": {
                        "fontWeight": "600"
                    }
                }
            },
            "core/group": {
                "@mobile": {
                    "spacing": {
                        "blockGap": "1rem"
                    }
                }
            }
        }
    }
}
