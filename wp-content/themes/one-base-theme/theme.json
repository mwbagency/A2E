{
    "$schema": "https://schemas.wp.org/trunk/theme.json",
    "version": 3,
    "settings": {
        "appearanceTools": true,
        "useRootPaddingAwareAlignments": true,
        "layout": {
            "contentSize": "760px",
            "wideSize": "1280px"
        },
        "viewport": {
            "mobile": "37.5rem",
            "tablet": "64rem"
        },
        "color": {
            "custom": false,
            "defaultPalette": false,
            "palette": [
                {
                    "name": "White / Base",
                    "slug": "base",
                    "color": "#FFFFFF"
                },
                {
                    "name": "Blue / Contrast",
                    "slug": "contrast",
                    "color": "#024959"
                },
                {
                    "name": "Red / Accent",
                    "slug": "accent",
                    "color": "#F24530"
                },
                {
                    "name": "Green",
                    "slug": "green",
                    "color": "#038C73"
                },
                {
                    "name": "Yellow",
                    "slug": "yellow",
                    "color": "#F0C577"
                },
                {
                    "name": "Grey 50 / Surface",
                    "slug": "surface",
                    "color": "#F9F9F9"
                },
                {
                    "name": "Grey 100",
                    "slug": "grey-100",
                    "color": "#EDEDED"
                },
                {
                    "name": "Grey 200",
                    "slug": "grey-200",
                    "color": "#D3D3D3"
                },
                {
                    "name": "Grey 400 / Muted",
                    "slug": "muted",
                    "color": "#A0A0A0"
                },
                {
                    "name": "Grey 600",
                    "slug": "grey-600",
                    "color": "#444444"
                },
                {
                    "name": "Grey 800",
                    "slug": "grey-800",
                    "color": "#3F3F3F"
                },
                {
                    "name": "Error",
                    "slug": "error",
                    "color": "#FF0000"
                },
                {
                    "name": "Success",
                    "slug": "success",
                    "color": "#1BCD32"
                },
                {
                    "name": "Warning",
                    "slug": "warning",
                    "color": "#EC841A"
                },
                {
                    "name": "Button outline",
                    "slug": "button-outline",
                    "color": "#1E411E"
                }
            ]
        },
        "spacing": {
            "blockGap": true,
            "margin": true,
            "padding": true,
            "defaultSpacingSizes": false,
            "units": [
                "px",
                "em",
                "rem",
                "vh",
                "vw",
                "%"
            ],
            "spacingSizes": [
                {
                    "name": "Small",
                    "slug": "sm",
                    "size": "1rem"
                },
                {
                    "name": "Medium",
                    "slug": "md",
                    "size": "1.5rem"
                },
                {
                    "name": "Large",
                    "slug": "lg",
                    "size": "2.5rem"
                },
                {
                    "name": "XL",
                    "slug": "xl",
                    "size": "4rem"
                },
                {
                    "name": "2XL",
                    "slug": "2-xl",
                    "size": "6rem"
                }
            ]
        },
        "typography": {
            "customFontSize": true,
            "defaultFontSizes": false,
            "fluid": true,
            "fontFamilies": [
                {
                    "name": "Inter",
                    "slug": "inter",
                    "fontFamily": "Inter, Arial, sans-serif",
                    "fontFace": [
                        {
                            "fontFamily": "Inter",
                            "fontStyle": "normal",
                            "fontWeight": "100 900",
                            "fontDisplay": "swap",
                            "src": [
                                "file:./assets/fonts/inter/InterVariable.woff2"
                            ]
                        }
                    ]
                },
                {
                    "name": "Accent serif",
                    "slug": "serif",
                    "fontFamily": "\"Caslon 540 BT\", \"Times New Roman\", serif"
                },
                {
                    "name": "Galano Grotesque",
                    "slug": "sans",
                    "fontFamily": "\"Galano Grotesque\", Arial, sans-serif",
                    "fontFace": [
                        {
                            "fontFamily": "Galano Grotesque",
                            "fontStyle": "normal",
                            "fontWeight": "300",
                            "fontDisplay": "swap",
                            "src": [
                                "file:./assets/fonts/galano-grotesque/GalanoGrotesque-Light.woff2"
                            ]
                        },
                        {
                            "fontFamily": "Galano Grotesque",
                            "fontStyle": "normal",
                            "fontWeight": "400",
                            "fontDisplay": "swap",
                            "src": [
                                "file:./assets/fonts/galano-grotesque/GalanoGrotesque-Regular.woff2"
                            ]
                        },
                        {
                            "fontFamily": "Galano Grotesque",
                            "fontStyle": "normal",
                            "fontWeight": "500",
                            "fontDisplay": "swap",
                            "src": [
                                "file:./assets/fonts/galano-grotesque/GalanoGrotesque-Medium.woff2"
                            ]
                        },
                        {
                            "fontFamily": "Galano Grotesque",
                            "fontStyle": "normal",
                            "fontWeight": "600",
                            "fontDisplay": "swap",
                            "src": [
                                "file:./assets/fonts/galano-grotesque/GalanoGrotesque-SemiBold.woff2"
                            ]
                        },
                        {
                            "fontFamily": "Galano Grotesque",
                            "fontStyle": "normal",
                            "fontWeight": "700",
                            "fontDisplay": "swap",
                            "src": [
                                "file:./assets/fonts/galano-grotesque/GalanoGrotesque-Bold.woff2"
                            ]
                        },
                        {
                            "fontFamily": "Galano Grotesque",
                            "fontStyle": "italic",
                            "fontWeight": "400",
                            "fontDisplay": "swap",
                            "src": [
                                "file:./assets/fonts/galano-grotesque/GalanoGrotesque-Italic.woff2"
                            ]
                        }
                    ]
                }
            ],
            "fontSizes": [
                {
                    "name": "Body",
                    "slug": "body",
                    "size": "1.25rem",
                    "fluid": false
                },
                {
                    "name": "Small",
                    "slug": "small",
                    "size": "1rem",
                    "fluid": false
                },
                {
                    "name": "Button",
                    "slug": "button",
                    "size": "1.125rem",
                    "fluid": false
                },
                {
                    "name": "Overline",
                    "slug": "overline",
                    "size": "1rem",
                    "fluid": false
                },
                {
                    "name": "Heading 6",
                    "slug": "h-6",
                    "size": "1.25rem",
                    "fluid": false
                },
                {
                    "name": "Heading 5",
                    "slug": "h-5",
                    "size": "1.5rem",
                    "fluid": false
                },
                {
                    "name": "Heading 4",
                    "slug": "h-4",
                    "size": "2rem",
                    "fluid": {
                        "min": "1.5rem",
                        "max": "2rem"
                    }
                },
                {
                    "name": "Heading 3",
                    "slug": "h-3",
                    "size": "2.625rem",
                    "fluid": {
                        "min": "1.75rem",
                        "max": "2.625rem"
                    }
                },
                {
                    "name": "Heading 2",
                    "slug": "h-2",
                    "size": "3.75rem",
                    "fluid": {
                        "min": "2.25rem",
                        "max": "3.75rem"
                    }
                },
                {
                    "name": "Heading 1",
                    "slug": "h-1",
                    "size": "5.625rem",
                    "fluid": {
                        "min": "3rem",
                        "max": "5.625rem"
                    }
                },
                {
                    "name": "Hero",
                    "slug": "hero",
                    "size": "5.625rem",
                    "fluid": {
                        "min": "3rem",
                        "max": "5.625rem"
                    }
                }
            ]
        },
        "custom": {
            "typography": {
                "fontWeight": {
                    "regular": "400",
                    "medium": "500",
                    "semibold": "600",
                    "bold": "700",
                    "light": "300"
                },
                "lineHeight": {
                    "tight": "0.933333",
                    "regular": "1.2",
                    "loose": "1.4"
                },
                "letterSpacing": {
                    "tight": "-1.3px",
                    "regular": "0",
                    "loose": "1.5px"
                }
            },
            "radius": {
                "card": "2px",
                "control": "100px",
                "panel": "3rem"
            },
            "shadow": {
                "card": "none"
            },
            "button": {
                "hoverOpacity": "0.75",
                "disabledOpacity": "0.2"
            }
        }
    },
    "customTemplates": [
        {
            "name": "courses-page",
            "title": "Courses page — A2E",
            "postTypes": [
                "page"
            ]
        },
        {
            "name": "testimonials-page",
            "title": "Client testimonials page — A2E",
            "postTypes": [
                "page"
            ]
        },
        {
            "name": "contact-page",
            "title": "Contact page — A2E",
            "postTypes": [
                "page"
            ]
        },
        {
            "name": "confirmation-page",
            "title": "Confirmation page — A2E",
            "postTypes": [
                "page"
            ]
        },
        {
            "name": "privacy-policy-page",
            "title": "Privacy policy page — A2E",
            "postTypes": [
                "page"
            ]
        },
        {
            "name": "simple-page",
            "title": "Simple page — A2E",
            "postTypes": [
                "page"
            ]
        },
        {
            "name": "faqs-page",
            "title": "FAQs page — A2E",
            "postTypes": [
                "page"
            ]
        },
        {
            "name": "service-page",
            "title": "Service page — A2E",
            "postTypes": [
                "service",
                "page"
            ]
        },
        {
            "name": "page-with-title",
            "title": "Page \u2014 automatic title",
            "postTypes": [
                "page"
            ]
        },
        {
            "name": "news-page",
            "title": "News page — A2E",
            "postTypes": [
                "page"
            ]
        },
        {
            "name": "single-post",
            "title": "Post — A2E",
            "postTypes": [
                "post"
            ]
        }
    ],
    "templateParts": [
        {
            "area": "header",
            "name": "head",
            "title": "Head"
        },
        {
            "area": "footer",
            "name": "footer",
            "title": "Footer"
        },
        {
            "area": "uncategorized",
            "name": "social-links",
            "title": "Social links"
        },
        {
            "area": "navigation-overlay",
            "name": "head-navigation-overlay",
            "title": "Head Navigation Overlay"
        }
    ],
    "styles": {
        "color": {
            "background": "var:preset|color|base",
            "text": "var:preset|color|contrast"
        },
        "spacing": {
            "padding": {
                "left": "clamp(20px, 4vw, 80px)",
                "right": "clamp(20px, 4vw, 80px)"
            }
        },
        "typography": {
            "fontFamily": "var:preset|font-family|sans",
            "fontSize": "var:preset|font-size|body",
            "fontWeight": "400",
            "lineHeight": "1.4",
            "letterSpacing": "0.5px"
        },
        "elements": {
            "h1": {
                "typography": {
                    "fontFamily": "var:preset|font-family|sans",
                    "fontSize": "var:preset|font-size|h-1",
                    "fontWeight": "700",
                    "lineHeight": "0.933333",
                    "letterSpacing": "-0.5px",
                    "textTransform": "none"
                }
            },
            "h2": {
                "typography": {
                    "fontFamily": "var:preset|font-family|sans",
                    "fontSize": "var:preset|font-size|h-2",
                    "fontWeight": "600",
                    "lineHeight": "0.933333",
                    "letterSpacing": "-1.3px",
                    "textTransform": "none"
                }
            },
            "h3": {
                "typography": {
                    "fontFamily": "var:preset|font-family|sans",
                    "fontSize": "var:preset|font-size|h-3",
                    "fontWeight": "300",
                    "lineHeight": "1.047619",
                    "letterSpacing": "0",
                    "textTransform": "none"
                }
            },
            "h4": {
                "typography": {
                    "fontFamily": "var:preset|font-family|sans",
                    "fontSize": "var:preset|font-size|h-4",
                    "fontWeight": "600",
                    "lineHeight": "1.125",
                    "letterSpacing": "0.25px",
                    "textTransform": "none"
                }
            },
            "h5": {
                "typography": {
                    "fontFamily": "var:preset|font-family|sans",
                    "fontSize": "var:preset|font-size|h-5",
                    "fontWeight": "600",
                    "lineHeight": "1.25",
                    "letterSpacing": "0",
                    "textTransform": "none"
                }
            },
            "h6": {
                "typography": {
                    "fontFamily": "var:preset|font-family|sans",
                    "fontSize": "var:preset|font-size|h-6",
                    "fontWeight": "500",
                    "lineHeight": "1.2",
                    "letterSpacing": "0.15px",
                    "textTransform": "none"
                }
            },
            "link": {
                "color": {
                    "text": "var:preset|color|accent"
                },
                "typography": {
                    "textDecoration": "underline"
                },
                ":hover": {
                    "color": {
                        "text": "var:preset|color|grey-800"
                    }
                }
            },
            "button": {
                "border": {
                    "radius": "var:custom|radius|control",
                    "width": "0"
                },
                "color": {
                    "background": "var:preset|color|accent",
                    "text": "var:preset|color|base"
                },
                "spacing": {
                    "padding": {
                        "top": "0.75rem",
                        "bottom": "0.75rem",
                        "left": "2rem",
                        "right": "2rem"
                    }
                },
                "typography": {
                    "fontFamily": "var:preset|font-family|sans",
                    "fontSize": "var:preset|font-size|button",
                    "fontWeight": "700",
                    "lineHeight": "1.111111",
                    "letterSpacing": "0",
                    "textDecoration": "none"
                },
                ":active": {
                    "color": {
                        "background": "var:preset|color|grey-800",
                        "text": "var:preset|color|base"
                    }
                },
                ":focus-visible": {
                    "outline": {
                        "color": "var:preset|color|contrast",
                        "offset": "0.25rem",
                        "style": "solid",
                        "width": "0.125rem"
                    }
                }
            }
        },
        "blocks": {
            "core/button": {
                "variations": {
                    "outline": {
                        "border": {
                            "color": "var:preset|color|button-outline",
                            "style": "solid",
                            "width": "1px",
                            "radius": "var:custom|radius|control"
                        },
                        "color": {
                            "background": "var:preset|color|base",
                            "text": "var:preset|color|accent"
                        },
                        "spacing": {
                            "padding": {
                                "top": "calc(0.75rem - 1px)",
                                "bottom": "calc(0.75rem - 1px)",
                                "left": "calc(2rem - 1px)",
                                "right": "calc(2rem - 1px)"
                            }
                        },
                        ":active": {
                            "border": {
                                "color": "var:preset|color|grey-800"
                            },
                            "color": {
                                "background": "var:preset|color|base",
                                "text": "var:preset|color|grey-800"
                            }
                        }
                    }
                }
            },
            "core/navigation-link": {
                ":hover": {
                    "color": {
                        "text": "var:preset|color|muted"
                    }
                },
                "-current": {
                    "typography": {
                        "fontWeight": "600"
                    }
                }
            },
            "core/group": {
                "@mobile": {
                    "spacing": {
                        "blockGap": "1rem"
                    }
                }
            },
            "core/post-content": {
                "spacing": {
                    "blockGap": "0"
                }
            },
            "core/paragraph": {
                "css": "&.has-small-font-size { line-height: 1.25; letter-spacing: 0; }"
            }
        }
    }
}
