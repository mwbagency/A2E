# BEGIN Project security
# The repository is mounted as the local Apache document root. Deny secrets,
# repository metadata and Composer manifests before WordPress handles requests.
<IfModule mod_rewrite.c>
RewriteEngine On
RewriteRule (^|/)\.(?!well-known(?:/|$)) - [F,L]
</IfModule>

<IfModule mod_authz_core.c>
<FilesMatch "^(?:auth\.json|composer\.(?:json|lock))$">
Require all denied
</FilesMatch>
</IfModule>
# END Project security

# BEGIN WordPress
# The directives (lines) between "BEGIN WordPress" and "END WordPress" are
# dynamically generated, and should only be modified via WordPress filters.
# Any changes to the directives between these markers will be overwritten.

# END WordPress
